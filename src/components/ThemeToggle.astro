---
---

<button
  id="theme-toggle"
  type="button"
  class="grid h-8 w-8 place-items-center rounded-full text-[var(--muted)] transition-colors hover:text-[var(--ink)] [&_svg]:col-start-1 [&_svg]:row-start-1 [&_svg]:h-[18px] [&_svg]:w-[18px]"
  aria-label="Cambiar tema"
>
  <!-- Sol: visible en claro -->
  <svg
    class="transition duration-200 will-change-transform dark:scale-50 dark:-rotate-45 dark:opacity-0 motion-reduce:rotate-0! motion-reduce:scale-100! motion-reduce:transition-none"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 3v2M12 19v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M3 12h2M19 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <!-- Luna: visible en oscuro -->
  <svg
    class="scale-50 rotate-45 opacity-0 transition duration-200 will-change-transform dark:scale-100 dark:rotate-0 dark:opacity-100 motion-reduce:rotate-0! motion-reduce:scale-100! motion-reduce:transition-none"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch (_) {}
    });
  })();
</script>
