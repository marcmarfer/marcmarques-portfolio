---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../data/site";
---

<header
  class="sticky top-0 z-40 border-b border-[var(--line)] bg-[color-mix(in_srgb,var(--bg)_85%,transparent)] backdrop-blur"
>
  <div
    class="mx-auto grid max-w-[1440px] grid-cols-[1fr_auto_1fr] items-center gap-4 px-6 py-4 sm:px-10"
  >
    <span
      class="hidden text-xs uppercase tracking-[0.12em] text-[var(--muted)] sm:inline"
    >
      {site.ciudad} — <time id="clock">00:00</time>
    </span>

    <a
      href="#contenido"
      class="col-start-1 justify-self-start text-[15px] font-medium tracking-[0.01em] sm:col-start-2 sm:justify-self-center"
    >
      {site.nombre}
    </a>

    <div class="flex items-center justify-end gap-1">
      <ThemeToggle />
      <a
        href="#contacto"
        class="rounded-full border border-[var(--line)] px-4 py-2 text-[13px] transition-colors hover:border-[var(--ink)]"
      >
        Hablemos
      </a>
    </div>
  </div>
</header>
