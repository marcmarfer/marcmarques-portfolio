---
import { site } from "../data/site";

const redes = [
  { nombre: "GitHub", url: site.redes.github },
  { nombre: "LinkedIn", url: site.redes.linkedin },
].filter((r) => r.url);

const anio = new Date().getFullYear();
---

<footer
  id="contacto"
  class="scroll-mt-24 border-t border-[var(--line)] px-6 pt-28 pb-24 text-center sm:px-10"
>
  <p data-reveal class="eyebrow">Contacto</p>
  <h2
    data-reveal="1"
    class="mt-4 text-[2.5rem] font-medium tracking-[-0.022em] sm:text-[3.25rem]"
  >
    Hablemos.
  </h2>
  <p data-reveal="2" class="mt-3.5 text-[1.05rem] text-[var(--muted)]">
    ¿Tienes un proyecto en mente o quieres saludar?
  </p>

  <a
    data-reveal="3"
    class="link-u mt-8 inline-block text-xl"
    href={`mailto:${site.email}`}
  >
    {site.email}
  </a>

  <div data-reveal="4" class="mt-10 flex justify-center gap-7 text-[15px]">
    {
      redes.map((red) => (
        <a
          href={red.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--muted)] transition-colors hover:text-[var(--ink)]"
        >
          {red.nombre}
        </a>
      ))
    }
  </div>

  <div
    data-reveal
    class="mx-auto mt-24 flex max-w-[1180px] flex-col items-center justify-between gap-2 border-t border-[var(--line)] pt-7 text-[13px] text-[var(--muted)] sm:flex-row"
  >
    <span>{site.nombreCompleto} — {site.ciudad}</span>
    <span>&copy; {anio}</span>
  </div>
</footer>
